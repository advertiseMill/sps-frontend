# SEO Configuration - Environment Variables

# Base URL for your site (used in sitemaps and meta tags)
VITE_SITE_URL=https://sps.example.com

# Enable debug mode for SEO monitoring
VITE_SEO_DEBUG=false

# Analytics configuration
VITE_GOOGLE_ANALYTICS_ID=
VITE_ENABLE_PERFORMANCE_MONITORING=true

# Image optimization base URL (optional)
VITE_IMAGE_OPTIMIZATION_URL=

# Crawl settings
VITE_ROBOTS_CRAWL_DELAY=1
